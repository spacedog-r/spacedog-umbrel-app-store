#!/usr/bin/env bash
set -euo pipefail

# Prepare only this app's state, never modify existing configuration.
APP_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
STATE_DIR="${APP_DIR}/data/state"
AUTH_DIR="${APP_DIR}/data/auth"
install -d -m 700 "${STATE_DIR}" "${AUTH_DIR}"
if [[ ! -e "${STATE_DIR}/openclaw.json" ]]; then
  ( umask 077; cat > "${STATE_DIR}/openclaw.json" <<'JSON'
{
  "gateway": {
    "mode": "local",
    "bind": "lan",
    "port": 18789
  }
}
JSON
  )
fi

# The upstream image runs as uid 1000; ensure it can write its own appdata.
chown -R 1000:1000 "${STATE_DIR}" "${AUTH_DIR}"
